JOB_AGENT_SECRET_KEY=replace-with-a-long-random-secret
JOB_AGENT_DATABASE_URL=postgresql://job_agent:change-me@host.docker.internal:5432/job_agent
JOB_AGENT_COOKIE_SECURE=true
JOB_AGENT_DEV_RETURN_OTP=false
JOB_AGENT_OTP_TTL_MINUTES=10
JOB_AGENT_SESSION_MAX_AGE_SECONDS=43200

# SMTP is used for email OTP delivery and recruiter email mode.
JOB_AGENT_SMTP_HOST=smtp.example.com
JOB_AGENT_SMTP_PORT=587
JOB_AGENT_SMTP_USERNAME=agent@example.com
JOB_AGENT_SMTP_PASSWORD=replace-with-secret
JOB_AGENT_SMTP_FROM=agent@example.com
