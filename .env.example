JOB_AGENT_SECRET_KEY=replace-with-a-long-random-secret
JOB_AGENT_DATABASE_URL=postgresql://job_agent:change-me@host.docker.internal:5432/job_agent
JOB_AGENT_COOKIE_SECURE=true
JOB_AGENT_DEV_RETURN_OTP=false
JOB_AGENT_OTP_TTL_MINUTES=10
JOB_AGENT_SESSION_MAX_AGE_SECONDS=43200
HOST=0.0.0.0
PORT=8000

# Bounded worker pools. Keep document rendering low because PDF/PNG validation is CPU intensive.
JOB_AGENT_DOCUMENT_WORKERS=2
JOB_AGENT_APPLICATION_WORKERS=4
JOB_AGENT_SEARCH_WORKERS=4

# SMTP is used for email OTP delivery and recruiter email mode.
JOB_AGENT_SMTP_HOST=smtp.example.com
JOB_AGENT_SMTP_PORT=587
JOB_AGENT_SMTP_USERNAME=agent@example.com
JOB_AGENT_SMTP_PASSWORD=replace-with-secret
JOB_AGENT_SMTP_FROM=agent@example.com

# Optional: distinct female neural accents for the mock interviewer.
JOB_AGENT_AZURE_SPEECH_KEY=replace-with-azure-speech-key
JOB_AGENT_AZURE_SPEECH_REGION=centralindia

# Optional shared LLM evaluator for resume writing quality and interview feedback.
# Both features retain deterministic evidence-based fallbacks without a key.
JOB_AGENT_LLM_API_KEY=
JOB_AGENT_LLM_MODEL=gpt-4o-mini
JOB_AGENT_LLM_ENDPOINT=https://api.openai.com/v1/responses

# Optional interview-only overrides. Leave blank to reuse the shared settings above.
# One request is made only when an interview section is completed, never per question.
JOB_AGENT_INTERVIEW_LLM_API_KEY=
JOB_AGENT_INTERVIEW_LLM_MODEL=
JOB_AGENT_INTERVIEW_LLM_ENDPOINT=
# Mock Test: optional extra AI-written MCQs for niche job skills. Leave blank to
# reuse JOB_AGENT_LLM_API_KEY; set JOB_AGENT_MOCK_TEST_LLM=off to use only the curated bank.
JOB_AGENT_MOCK_TEST_LLM=on
JOB_AGENT_MOCK_TEST_LLM_API_KEY=
JOB_AGENT_MOCK_TEST_LLM_MODEL=
JOB_AGENT_MOCK_TEST_LLM_ENDPOINT=

# Optional trained semantic matching. Local mode requires: pip install -e ".[semantic]"
JOB_AGENT_ENABLE_LOCAL_EMBEDDINGS=false
JOB_AGENT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Alternatively configure an OpenAI-compatible embedding endpoint.
JOB_AGENT_EMBEDDING_API_KEY=
JOB_AGENT_EMBEDDING_ENDPOINT=
# Upper limit in seconds for the whole portal search in one run (default 45).
# Portals that have not answered by then are skipped for that run.
JOB_AGENT_SEARCH_BUDGET_SECONDS=45

# --- Extra job sources -------------------------------------------------------
# Jobicy and Remote OK need no key and are always on. The three below switch on
# only when their key is set; each is free for developers/publishers.
# Adzuna India: https://developer.adzuna.com (app id + key)
JOB_AGENT_ADZUNA_APP_ID=
JOB_AGENT_ADZUNA_APP_KEY=
# Careerjet India (en_IN): publisher API key from https://www.careerjet.com/partners/api
JOB_AGENT_CAREERJET_API_KEY=
# Careerjet needs the end user's IP; scheduled runs have none, so they skip
# Careerjet unless a fallback is set (e.g. the server's public IP).
JOB_AGENT_CAREERJET_FALLBACK_IP=
# Jooble: request a key at https://jooble.org/api/about
JOB_AGENT_JOOBLE_API_KEY=
# Google for Jobs via JSearch: brings in listings that Indeed, Foundit, WorkIndia,
# Shine, Glassdoor and company sites publish to Google (they have no public API).
# Free plan: 200 requests/month (RapidAPI or https://www.openwebninja.com/api/jsearch).
JOB_AGENT_JSEARCH_API_KEY=
# rapidapi (default, header x-rapidapi-key) or openwebninja (header x-api-key)
JOB_AGENT_JSEARCH_PROVIDER=rapidapi
# Queries per run; each uses quota. Results are cached for 6 hours across users.
JOB_AGENT_JSEARCH_QUERIES_PER_RUN=3

# --- Production guardrails -----------------------------------------------------
# Human approval: recruiter emails always wait for the user's approval in the web app.
# (false only for a local CLI operator who sends their own emails)
JOB_AGENT_REQUIRE_APPROVAL=true
JOB_AGENT_EMAIL_DAILY_CAP=20
JOB_AGENT_EMAIL_UNDO_SECONDS=60
JOB_AGENT_EMAIL_DUPLICATE_DAYS=30
# Rate limits ("count/seconds"). JOB_AGENT_RATE_LIMITS=off only for local testing.
JOB_AGENT_RATE_LIMITS=on
JOB_AGENT_LIMIT_OTP_REQUEST_EMAIL=3/900
JOB_AGENT_LIMIT_OTP_REQUEST_IP=20/900
JOB_AGENT_LIMIT_OTP_VERIFY_IP=30/900
JOB_AGENT_LIMIT_RUN=10/3600
JOB_AGENT_LIMIT_MOCK_TEST=30/86400
JOB_AGENT_LIMIT_MOCK_INTERVIEW=20/86400
# Proxies in front of the app that append to X-Forwarded-For (CloudFront + ALB = 2).
JOB_AGENT_TRUSTED_PROXY_HOPS=2
# LLM spend caps (USD) and per-run token cap. Over a cap, local evaluators are used.
JOB_AGENT_LLM_DAILY_BUDGET_USD=5
JOB_AGENT_LLM_USER_DAILY_BUDGET_USD=0.25
JOB_AGENT_LLM_RUN_TOKEN_BUDGET=24000
JOB_AGENT_LLM_PRICE_INPUT_PER_1M=0.15
JOB_AGENT_LLM_PRICE_OUTPUT_PER_1M=0.60

# --- Privacy (DPDP Act 2023) -----------------------------------------------------
JOB_AGENT_REQUIRE_CONSENT=true
JOB_AGENT_CONSENT_VERSION=2026-10
# Accounts with no sign-in for this many days are deleted automatically (minimum 30).
JOB_AGENT_RETENTION_DAYS=180

# --- Metrics and admin -------------------------------------------------------------
# Comma-separated emails that can open /admin/metrics.
JOB_AGENT_ADMIN_EMAILS=
# emf = CloudWatch Embedded Metric Format log lines (metrics appear automatically on ECS).
JOB_AGENT_METRICS_FORMAT=emf
JOB_AGENT_METRICS_NAMESPACE=JobHuntingAgent
# Scheduled-run queue: attempts before SQS moves a failing message to the DLQ.
JOB_AGENT_QUEUE_MAX_RECEIVES=3
